# Copy to .env.local and fill in. Every variable is optional, and none is
# secret: they are build-time values baked into the static site. Real secrets
# (the email API key) live in the quote worker — see integrations/quote-worker.

# The company's live address, no trailing slash. Used for canonical URLs,
# Open Graph, the sitemap and robots.txt.
NEXT_PUBLIC_SITE_URL=

# Where the quote form POSTs. The included worker's URL, or any form service
# that accepts JSON (multipart when photos are attached) and answers 2xx.
# Leave empty and the form says plainly that online requests are not
# connected, sends nothing, and offers phone and email instead.
NEXT_PUBLIC_QUOTE_ENDPOINT=

# Only for services that want a public key in the body (Web3Forms calls it
# access_key). Sent as "access_key".
NEXT_PUBLIC_QUOTE_ACCESS_KEY=

# Set by the repo build when the site is published under the dashboard.
# Leave unset for the company's own hosting.
# NEXT_PUBLIC_BASE_PATH=
