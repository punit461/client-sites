# Copy to .env.local and fill in. Every variable is optional.

# The school's live address, no trailing slash. Used for canonical URLs,
# Open Graph, the sitemap and robots.txt.
NEXT_PUBLIC_SITE_URL=https://www.aldenmoor.example

# Where the enquiry forms POST their JSON. Any form backend that accepts JSON
# and answers 2xx on success works: Formspree, Web3Forms, Basin, a Google Apps
# Script web app, or your own endpoint. Leave empty and the forms say plainly
# that online enquiries are not connected, and offer email/phone instead.
NEXT_PUBLIC_ENQUIRY_ENDPOINT=

# Only for services that want a public key in the body (Web3Forms calls it
# access_key). Sent as "access_key".
NEXT_PUBLIC_ENQUIRY_ACCESS_KEY=

# Set by the repo build when the site is published under the dashboard.
# Leave unset for the school's own hosting.
# NEXT_PUBLIC_BASE_PATH=
